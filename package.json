{
  "name": "cardinal-system",
  "version": "0.2.8",
  "license": "MIT",
  "private": true,
  "workspaces": ["packages/*", "backend", "frontend"],
  "scripts": {
    "dev:backend": "bun --watch backend/src/index.ts",
    "dev:frontend": "bun run --cwd frontend dev",
    "build": "bun run --cwd frontend build",
    "start": "bun backend/src/index.ts",
    "test": "bun test --timeout 30000 packages/*/src backend/src scripts/*.test.ts",
    "test:e2e": "bun run --cwd frontend playwright test",
    "typecheck": "bun x tsc --noEmit -p backend/tsconfig.json && bun x tsc --noEmit -p packages/mcp/tsconfig.json && bun x tsc --noEmit -p frontend/tsconfig.json",
    "keygen": "bun packages/keys/src/cli.ts",
    "cloud-agent": "bun scripts/cloud-agent.ts",
    "bootstrap:password": "bash scripts/bootstrap-admin-password.sh",
    "hooks:install": "bash scripts/install-hooks.sh",
    "standards:sync": "bun scripts/sync-repo-standards.ts",
    "seed:router": "python3 scripts/seed-router.py"
  },
  "devDependencies": {
    "@cursor/sdk": "1.0.31"
  }
}
