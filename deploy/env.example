# Cardinal System — environment config
# Dev: copy to .env at repo root. Quadlet: copy to ~/.config/cardinal/env.

ADMIN_USER=admin

# generate: bun run bootstrap:password (or bash scripts/bootstrap-admin-password.sh)
ADMIN_PASSWORD_HASH=

# generate: openssl rand -hex 32
JWT_SECRET=

# AES-256-GCM key for provider API secrets stored in DB
# generate: openssl rand -hex 32
POOL_SECRET=

# Optional shared secret for /api/internal/* between MCP and backend
# generate: openssl rand -hex 32
INTERNAL_SERVICE_SECRET=

PORT=8787

# Dev default. In the quadlet deploy the container image already sets
# DB_PATH=/data/cardinal.db (on the cardinal-data volume) — leave it unset there.
DB_PATH=./cardinal.db

# MCP service: host path of the markdown vaults, mounted read-only at
# /data/vaults inside the cardinal-mcp container. Absolute host path.
VAULTS_HOST_PATH=/path/to/vaults

# Isolated writable folder for agent handoffs and skill proposals (/data/agent-state).
AGENT_STATE_HOST_PATH=/path/to/agent-state

# Secret-redacted host config snapshots produced by scripts/sync-configs.sh (/data/configs:ro).
CONFIGS_HOST_PATH=/path/to/configs

# Comma-separated top-level prefixes blocked from agent reads unless key has vault:allow-personal.
CARDINAL_DENY_PREFIXES=personal

# Auto-commit individual handoff/proposal writes if AGENT_STATE_HOST_PATH is a git repo.
CARDINAL_GIT_AUTOCOMMIT=true

# Optional QMD sidecar URL (compose --profile qmd). Leave blank to use built-in SQLite FTS5.
QMD_URL=

# Cursor Cloud Agent API key for automated UI testing (optional)
# obtain from: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
