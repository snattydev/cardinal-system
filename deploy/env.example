# Cardinal System — environment config
# Dev: copy to .env at repo root. Quadlet: copy to ~/.config/cardinal/env.

ADMIN_USER=admin

# generate: bun run bootstrap:password (or bash scripts/bootstrap-admin-password.sh)
ADMIN_PASSWORD_HASH=

# generate: openssl rand -hex 32
JWT_SECRET=

# AES-256-GCM key for provider API secrets stored in DB
# generate: openssl rand -hex 32
POOL_SECRET=

# Optional shared secret for /api/internal/* between MCP and backend
# generate: openssl rand -hex 32
INTERNAL_SERVICE_SECRET=

# Backend port only. cardinal-mcp.container reads ~/.config/cardinal/mcp.env
# and explicitly sets Environment=PORT=8789.
PORT=8787

# Host Bun dev default is ./cardinal.db; compose.yaml and the Quadlet backend
# container both set DB_PATH=/data/cardinal.db. Leave commented out in Quadlet
# so SQLite persists on cardinal-data.volume instead of ephemeral container FS.
# DB_PATH=./cardinal.db

# --- Local compose.yaml ONLY ---
# Quadlet mounts vaults/agent-state/configs via Volume= lines in
# deploy/quadlet/cardinal-mcp.container and reads MCP settings from
# ~/.config/cardinal/mcp.env (see deploy/mcp.env.example).

# MCP service: host path of the markdown vaults, mounted read-only at
# /data/vaults inside the cardinal-mcp container (compose.yaml only).
VAULTS_HOST_PATH=/path/to/vaults

# Isolated writable folder for agent handoffs and skill proposals (compose.yaml only).
AGENT_STATE_HOST_PATH=/path/to/agent-state

# Secret-redacted host config snapshots produced by scripts/sync-configs.sh (compose.yaml only).
CONFIGS_HOST_PATH=/path/to/configs

# Comma-separated top-level prefixes blocked from agent reads unless the key
# has vault:allow-personal (compose.yaml only; set in mcp.env for Quadlet).
#   CARDINAL_DENY_PREFIXES=personal,private-vault
CARDINAL_DENY_PREFIXES=personal

# Auto-commit individual handoff/proposal writes if AGENT_STATE_HOST_PATH is a
# git repo and git is present (compose.yaml only; set in mcp.env for Quadlet).
CARDINAL_GIT_AUTOCOMMIT=true

# Optional QMD sidecar URL (compose --profile qmd only). Leave blank to use built-in SQLite FTS5.
QMD_URL=

# Cursor Cloud Agent API key for automated UI testing (optional)
# obtain from: https://cursor.com/dashboard/integrations
CURSOR_API_KEY=
