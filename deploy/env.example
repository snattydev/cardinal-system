# Cardinal System — environment config
# Dev: copy to .env at repo root. Quadlet: copy to ~/.config/cardinal/env.

ADMIN_USER=admin

# generate: bun -e 'console.log(await Bun.password.hash("your-password"))'
ADMIN_PASSWORD_HASH=

# generate: openssl rand -hex 32
JWT_SECRET=

# AES-256-GCM key for provider API secrets stored in DB
# generate: openssl rand -hex 32
POOL_SECRET=

PORT=8787

# Dev default. In the quadlet deploy the container image already sets
# DB_PATH=/data/cardinal.db (on the cardinal-data volume) — leave it unset there.
DB_PATH=./cardinal.db

# MCP service: host path of the markdown vaults, mounted read-only at
# /data/vaults inside the cardinal-mcp container. Absolute host path.
VAULTS_HOST_PATH=/home/snatty/Documents/vaults
