# Cardinal System - MCP Context Hub environment config (Quadlet)
# Copy to ~/.config/cardinal/mcp.env so cardinal-mcp does not inherit backend
# secrets (ADMIN_PASSWORD_HASH, JWT_SECRET, POOL_SECRET).

# Shared secret for /api/internal/* between cardinal-mcp and cardinal-backend.
# Must match INTERNAL_SERVICE_SECRET in ~/.config/cardinal/env.
# generate: openssl rand -hex 32
INTERNAL_SERVICE_SECRET=

# Comma-separated top-level vault prefixes blocked from agent reads unless the
# key has vault:allow-personal. Example:
#   CARDINAL_DENY_PREFIXES=personal,private-vault
CARDINAL_DENY_PREFIXES=personal

# Auto-commit individual handoff/proposal writes when agent-state is a git repo
# AND git is available in the container image. Slim images omit git and silently
# degrade to committed=false while still writing safely.
CARDINAL_GIT_AUTOCOMMIT=true

# Optional QMD sidecar URL. Leave blank to use built-in SQLite FTS5.
QMD_URL=
