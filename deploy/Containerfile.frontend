# Cardinal System — Frontend container
# Build: podman build -t cardinal-frontend:latest -f deploy/Containerfile.frontend .
#
# Multi-stage: builds the React app with Bun, then serves it via nginx.
# Nginx also proxies /api and /ws to the backend container within the pod.

# ---- Build stage ----
FROM docker.io/oven/bun:1 AS build
WORKDIR /app

COPY package.json ./
COPY frontend/package.json frontend/bun.lock ./frontend/
RUN cd frontend && bun install --frozen-lockfile

COPY frontend ./frontend
RUN cd frontend && bun run build

# ---- Runtime stage ----
FROM docker.io/nginx:alpine

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy our custom nginx config (proxies /api, /ws to backend)
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built frontend assets
COPY --from=build /app/frontend/dist /usr/share/nginx/html

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:8000/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
