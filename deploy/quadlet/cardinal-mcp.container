[Unit]
Description=Cardinal MCP Context Hub container - Streamable HTTP MCP server
After=network-online.target cardinal-backend.service

[Container]
Image=localhost/cardinal-mcp:latest
Pod=cardinal.pod
User=1000:1000
# Dedicated MCP env file isolates MCP from backend secrets (JWT_SECRET,
# POOL_SECRET, ADMIN_PASSWORD_HASH) in ~/.config/cardinal/env.
EnvironmentFile=%h/.config/cardinal/mcp.env

# Explicit Environment= lines follow EnvironmentFile as defense-in-depth so
# MCP always binds 8789 and keeps fixed container mount paths.
Environment=PORT=8789
Environment=CARDINAL_BACKEND_URL=http://127.0.0.1:8787
Environment=CARDINAL_VAULTS_ROOT=/data/vaults
Environment=CARDINAL_WRITABLE_ROOT=/data/agent-state
Environment=CARDINAL_CONFIGS_ROOT=/data/configs
Environment=CARDINAL_INDEX_DB=/tmp/cardinal-mcp-index.db

# Portable bind mounts under the home directory (no hardcoded host paths).
# Create them first:
#   mkdir -p %h/.local/share/cardinal/{vaults,agent-state,configs}
# Point these at your own markdown vaults, agent-state, and redacted config
# snapshots if they live elsewhere. Source vaults stay read-only; only
# agent-state is writable (and must be treated as untrusted until reviewed).
# SELinux note: add ",Z" only on SELinux-enforcing hosts. Never add it blindly
# to shared personal folders, because relabeling mutates host metadata.
Volume=%h/.local/share/cardinal/vaults:/data/vaults:ro
Volume=%h/.local/share/cardinal/agent-state:/data/agent-state:rw
Volume=%h/.local/share/cardinal/configs:/data/configs:ro

[Service]
Restart=always
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=cardinal-pod.service
