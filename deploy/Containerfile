# Cardinal System - Backend container
# Build: podman build --format docker -t localhost/cardinal-backend:latest -f deploy/Containerfile .
#
# This image contains only the Bun backend (API + WebSocket).
# Frontend static files are served by the cardinal-frontend container (nginx).
# Production DB is stored on the cardinal-data volume at /data/.

FROM docker.io/oven/bun:1-slim
WORKDIR /app

ENV NODE_ENV=production \
    PORT=8787 \
    DB_PATH=/data/cardinal.db

# Workspace manifests (all members required for bun install resolution)
COPY package.json bun.lock ./
COPY packages ./packages
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/

RUN bun install --production --frozen-lockfile

# Backend source (packages/ already copied above — Bun runs TS from src/)
COPY backend ./backend

# Persistent volume for SQLite database (writable by non-root bun user)
RUN mkdir -p /data && chown bun:bun /data
VOLUME /data

USER bun

EXPOSE 8787

# HEALTHCHECK — uses Bun's built-in fetch (no curl/wget needed in slim image)
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD bun -e "fetch('http://localhost:8787/api/health').then(r=>r.ok?process.exit(0):process.exit(1)).catch(()=>process.exit(1))"

CMD ["bun", "backend/src/index.ts"]
